# ---------------------------------------------------------------------------
# Meridian environment. Copy to `.env` (gitignored) and fill in real values.
#   cp .env.example .env
#
# Meridian is a naira-first product: NGN is the home currency, the banking day
# closes in Africa/Lagos, and every default limit below is denominated in kobo
# (1 naira = 100 kobo).
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
API_PREFIX=api
WEB_ORIGIN=http://localhost:5173

# --- Money / locale -----------------------------------------------------------
# Home currency for new accounts, statements and the demo data.
DEFAULT_CURRENCY=NGN
DEFAULT_LOCALE=en-NG
BANK_TIMEZONE=Africa/Lagos

# --- Database -----------------------------------------------------------------
# DATABASE_URL is used for migrations and admin tasks: use the DIRECT (non-pooled)
# Neon URL. DATABASE_URL_POOLED is used by the API at runtime.
# Local docker-compose defaults below point at the container in docker-compose.yml.
DATABASE_URL=postgresql://meridian:meridian@localhost:5433/meridian?schema=public
DATABASE_URL_POOLED=postgresql://meridian:meridian@localhost:5433/meridian?schema=public
# Separate database used by the integration test suite (recreated per run).
DATABASE_URL_TEST=postgresql://meridian:meridian@localhost:5433/meridian_test?schema=public
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000

# --- Redis --------------------------------------------------------------------
# Used for real-time fan-out (pub/sub), velocity-limit counters and hot reads.
REDIS_URL=redis://localhost:6380

# --- Auth ---------------------------------------------------------------------
# openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-at-least-32-chars
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
MFA_ISSUER=Meridian Bank
# Step-up MFA above this amount, in kobo: 5,000,000 kobo = NGN 50,000.
STEP_UP_THRESHOLD_MINOR=5000000

# --- Real time ----------------------------------------------------------------
# Server-sent events stream: heartbeats keep proxies from closing idle connections,
# and `Last-Event-ID` replays missed events so a dropped connection is invisible.
REALTIME_ENABLED=true
SSE_HEARTBEAT_MS=15000
SSE_REPLAY_LIMIT=200
REALTIME_CHANNEL=meridian:realtime

# --- Risk / limits (all in kobo) ----------------------------------------------
# NIBSS NIP-style ceiling per single transfer: 100,000,000 kobo = NGN 1,000,000.
LIMIT_PER_TRANSACTION_MINOR=100000000
# Per-account daily ceiling: 500,000,000 kobo = NGN 5,000,000.
LIMIT_DAILY_MINOR=500000000
# Per-account monthly ceiling: 5,000,000,000 kobo = NGN 50,000,000.
LIMIT_MONTHLY_MINOR=5000000000
RISK_ANOMALY_ZSCORE_THRESHOLD=3.0
RISK_MIN_HISTORY_FOR_ANOMALY=10

# --- Jobs ---------------------------------------------------------------------
ENABLE_SCHEDULERS=true
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50
SETTLEMENT_INTERVAL_MS=5000

# --- Mail ---------------------------------------------------------------------
SMTP_URL=smtp://localhost:1026
MAIL_FROM=no-reply@meridian.ng

# --- Observability ------------------------------------------------------------
LOG_LEVEL=debug
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
METRICS_ENABLED=true

# --- Frontend (Vite reads these from .env at the repo root) --------------------
VITE_API_URL=http://localhost:4000/api
VITE_SSE_URL=http://localhost:4000/api/events
