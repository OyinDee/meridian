{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "outDir": "./dist",
    "baseUrl": "./",
    "rootDir": "./",
    "types": ["node"],
    "strictPropertyInitialization": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "prisma/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}
